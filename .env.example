# ---------------------------------------------------------------------------
# Copy to .env.local and fill in. Never commit .env.local.
# ---------------------------------------------------------------------------

NEXT_PUBLIC_APP_URL=http://localhost:3000
CAPACITOR_SERVER_URL=

# --- Supabase --------------------------------------------------------------
# Point these at the EXISTING production project. This app is built on the
# live schema (migrations 0001-0034); it does not need new tables.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses row-level security; used solely to delete an auth user
# when someone deletes their account. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- OpenAI ----------------------------------------------------------------
# Optional. Without a key the app still runs: SOS, tools, check-ins and
# journalling all work, and support chat says plainly that it is unavailable.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_MODEL_COACH=gpt-5-mini
OPENAI_MODEL_JOURNAL=gpt-5-mini
OPENAI_MODEL_INSIGHTS=gpt-5-mini
OPENAI_MODEL_TWIN_PROFILE=gpt-5-mini
OPENAI_MODEL_TWIN_RESPONSE=gpt-5
OPENAI_MODEL_MEMORY=gpt-5-mini
OPENAI_MODEL_TRANSCRIBE=gpt-4o-mini-transcribe

# --- Billing ---------------------------------------------------------------
NEXT_PUBLIC_REVENUECAT_APPLE_API_KEY=
NEXT_PUBLIC_REVENUECAT_OFFERING_ID=default
NEXT_PUBLIC_REVENUECAT_PRO_ENTITLEMENT_ID=pro
NEXT_PUBLIC_REVENUECAT_PREMIUM_ENTITLEMENT_ID=premium
NEXT_PUBLIC_REVENUECAT_PLATINUM_ENTITLEMENT_ID=platinum
NEXT_PUBLIC_REVENUECAT_PRO_PACKAGE_ID=pro
NEXT_PUBLIC_REVENUECAT_PREMIUM_PACKAGE_ID=premium
REVENUECAT_REST_API_KEY=
REVENUECAT_WEBHOOK_AUTH=

# Web checkout. Without these, the upgrade page says so plainly instead of
# bouncing people back to /upgrade — that was the old conversion bug.
BILLING_PRO_URL=
BILLING_PREMIUM_URL=

# --- Other -----------------------------------------------------------------
TAVUS_API_KEY=
CRON_SECRET=
APNS_BUNDLE_ID=com.mentara.app
